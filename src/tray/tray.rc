// winapfs-tray resources
#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "tray.manifest"

IDI_APP ICON "..\\..\\assets\\winapfs.ico"

IDD_UNLOCK DIALOGEX 0, 0, 260, 114
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unlock APFS volume"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "", IDC_UNLOCK_TEXT, 10, 8, 240, 18
    LTEXT           "", IDC_HINT, 10, 28, 240, 10
    EDITTEXT        IDC_PASSWORD, 10, 42, 240, 14, ES_PASSWORD | ES_AUTOHSCROLL
    AUTOCHECKBOX    "Remember password in Windows Credential Manager", IDC_REMEMBER, 10, 63, 240, 12
    DEFPUSHBUTTON   "Unlock", IDOK, 146, 88, 50, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 88, 50, 16
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WINAPFS_VERSION_COMMA
 PRODUCTVERSION WINAPFS_VERSION_COMMA
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "winapfs contributors"
            VALUE "FileDescription", "winapfs tray (APFS disks)"
            VALUE "FileVersion", WINAPFS_VERSION_STR
            VALUE "LegalCopyright", "GPL-2.0. Uses WinFsp - Windows File System Proxy, Copyright (C) Bill Zissimopoulos"
            VALUE "ProductName", "winapfs"
            VALUE "ProductVersion", WINAPFS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
